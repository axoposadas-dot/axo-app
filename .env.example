# AXO App — Variables de Entorno
# Copiar a .env.local para desarrollo local

# === Aplicación ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AXO
NEXT_PUBLIC_APP_VERSION=1.0.0-mvp

# === Región ===
NEXT_PUBLIC_DEFAULT_CITY=Posadas
NEXT_PUBLIC_DEFAULT_COUNTRY=Argentina

# === API (futuro) ===
# NEXT_PUBLIC_API_URL=https://api.axo.app
# API_SECRET_KEY=your_secret_key_here

# === Maps (futuro — Google Maps o Mapbox) ===
# NEXT_PUBLIC_MAPS_API_KEY=your_maps_key_here

# === Analytics (futuro) ===
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
